# Files excluded from `gcloud run deploy --source .` uploads.
# The Dockerfile build still needs src/, public/, index.html, configs and server.js.
.gcloudignore
.git
.gitignore
.github

# Dependencies and build artifacts (rebuilt inside the container)
node_modules
dist
dist-ssr
coverage
*.tsbuildinfo

# Logs and local/editor state
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
.vscode
.idea
*.local

# Secrets and credentials must never enter an image or upload
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*credentials*.json
*service-account*.json
*serviceaccount*.json
.npmrc
.netrc
.gcloud
.config/gcloud
